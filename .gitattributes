# Source is LF everywhere so diffs show real changes, not line endings.
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.nsh  text eol=lf
*.html text eol=lf
# Fixtures keep their exact bytes (some test CRLF input on purpose).
test-fixtures/** -text
*.bat  text eol=crlf
*.ps1  text eol=crlf
# The stetwise-review launchers: a shell script for macOS (LF) and a batch file for Windows (CRLF).
build/stetwise-review      text eol=lf
build/stetwise-review.cmd  text eol=crlf
*.cmd  text eol=crlf
